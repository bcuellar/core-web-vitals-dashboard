# Copy to .env.local and adjust. Never commit real secrets.

# SQLite database file. Created (with migrations applied) on first use.
DATABASE_PATH=./data/observatory.db

# Google PageSpeed Insights API key. Optional, but unauthenticated requests
# are heavily rate limited. Create one at:
# https://developers.google.com/speed/docs/insights/v5/get-started#APIKey
PSI_API_KEY=

# Shared secret for POST /api/collect (used by cron/schedulers).
# The endpoint is disabled while this is empty. Generate with: openssl rand -hex 32
CRON_SECRET=

# Number of PageSpeed Insights requests to run in parallel (1-10).
COLLECT_CONCURRENCY=2
